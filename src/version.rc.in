#include <windows.h>
1 VERSIONINFO
FILEVERSION @VERSION_COMMAS@
PRODUCTVERSION @VERSION_COMMAS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Nolan Chai\0"
            VALUE "FileDescription", "SwitchView capture-card viewer\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "InternalName", "SwitchView\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Nolan Chai. GPL-3.0-or-later.\0"
            VALUE "OriginalFilename", "SwitchView.exe\0"
            VALUE "ProductName", "SwitchView\0"
            VALUE "ProductVersion", "@VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
